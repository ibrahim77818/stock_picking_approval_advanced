<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ form -->
    <record id="view_picking_form_inherit_approval" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.approval</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Validate buttons are replaced by the approval buttons while under review -->
            <xpath expr="//header/button[@name='button_validate'][1]" position="attributes">
                <attribute name="invisible" add="state == 'to_approve'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='button_validate'][2]" position="attributes">
                <attribute name="invisible" add="state == 'to_approve'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='button_validate'][1]" position="before">
                <button name="action_approval_approve" type="object" string="Approve"
                        class="oe_highlight" icon="fa-check" data-hotkey="a"
                        invisible="not approval_can_decide" groups="stock.group_stock_user"/>
                <button name="action_approval_reject" type="object" string="Reject"
                        class="btn-danger" icon="fa-times" data-hotkey="r"
                        invisible="not approval_can_decide" groups="stock.group_stock_user"/>
                <button name="action_approval_recall" type="object" string="Recall Request"
                        invisible="not approval_can_recall" groups="stock.group_stock_user"
                        confirm="Recall this approval request? The transfer will return to its previous state."/>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="after">
                <button name="action_cancel" type="object" string="Cancel" invisible="state != 'to_approve'"
                        groups="stock.group_stock_manager"
                        confirm="Are you sure you want to cancel this transfer?"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="state != 'to_approve'">
                    <div>
                        <i class="fa fa-hourglass-half me-1" title="Waiting for approval"/>
                        <strong>Waiting for approval</strong>
                    </div>
                    <div class="d-flex flex-wrap align-items-center">
                        <span class="me-1">Current tier:</span>
                        <field name="approval_current_line_id" readonly="1" options="{'no_open': True}" class="fw-bold"/>
                        <span class="ms-4 me-1">Signed tiers:</span>
                        <field name="approval_progress" class="fw-bold"/>
                    </div>
                    <div class="small">Operations and reservations are locked until a decision is made.</div>
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="approval_state != 'rejected'">
                    <div>
                        <i class="fa fa-ban me-1" title="Rejected"/>
                        <strong>Approval rejected</strong>
                    </div>
                    <div class="d-flex flex-wrap align-items-center">
                        <span class="me-1">Reason:</span>
                        <field name="approval_rejection_reason" class="fw-bold"/>
                    </div>
                    <div class="small">Correct the transfer and validate it again to start a new approval cycle.</div>
                </div>
            </xpath>
            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Approved" bg_color="text-bg-success"
                        invisible="approval_state != 'approved' or state == 'done'"/>
            </xpath>

            <!-- Freeze operations while under review -->
            <xpath expr="//field[@name='move_ids_without_package']" position="attributes">
                <attribute name="readonly" add="state == 'to_approve'" separator=" or "/>
            </xpath>

            <xpath expr="//notebook/page[@name='extra']" position="before">
                <page string="Approval Info" name="approval_info" invisible="approval_state == 'none' and not approval_line_ids">
                    <group>
                        <group>
                            <field name="approval_state" widget="badge"
                                   decoration-warning="approval_state == 'pending'"
                                   decoration-success="approval_state == 'approved'"
                                   decoration-danger="approval_state == 'rejected'"/>
                            <field name="approval_rule_id" options="{'no_create': True}"/>
                            <field name="approval_cycle"/>
                            <field name="approval_progress" invisible="approval_state != 'pending'"/>
                            <field name="approval_current_approver_ids" widget="many2many_avatar_user"
                                   invisible="approval_state != 'pending'"/>
                        </group>
                        <group>
                            <field name="approval_requested_by_id" widget="many2one_avatar_user"/>
                            <field name="approval_requested_date"/>
                            <field name="approval_done_date" invisible="approval_state != 'approved'"/>
                            <field name="approval_rejection_reason" invisible="not approval_rejection_reason"/>
                        </group>
                    </group>
                    <field name="approval_line_ids" readonly="1">
                        <list decoration-success="state == 'approved'"
                              decoration-danger="state == 'rejected'"
                              decoration-warning="state == 'pending'"
                              decoration-muted="state in ('cancelled', 'waiting')">
                            <field name="cycle" optional="show"/>
                            <field name="sequence" string="#" optional="hide"/>
                            <field name="name"/>
                            <field name="approver_user_ids" widget="many2many_avatar_user"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'approved'"
                                   decoration-danger="state == 'rejected'"
                                   decoration-warning="state == 'pending'"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date"/>
                            <field name="comment" optional="show"/>
                            <field name="rejection_reason" optional="hide"/>
                            <field name="signature" widget="image" options="{'size': [120, 40]}" optional="show" invisible="not signature"/>
                        </list>
                        <form string="Sign-off">
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="cycle"/>
                                    <field name="state"/>
                                    <field name="approver_user_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="user_id"/>
                                    <field name="date"/>
                                    <field name="rule_id"/>
                                </group>
                            </group>
                            <group>
                                <field name="comment"/>
                                <field name="rejection_reason" invisible="state != 'rejected'"/>
                                <field name="signature" widget="image" invisible="not signature"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ list -->
    <record id="vpicktree_inherit_approval" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.approval</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="approval_state" optional="hide" widget="badge"
                       invisible="approval_state == 'none'"
                       decoration-warning="approval_state == 'pending'"
                       decoration-success="approval_state == 'approved'"
                       decoration-danger="approval_state == 'rejected'"/>
                <field name="approval_current_approver_ids" optional="hide" widget="many2many_avatar_user"/>
            </xpath>
        </field>
    </record>

    <!-- ========================================================== search -->
    <record id="view_picking_internal_search_inherit_approval" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.approval</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='available']" position="after">
                <filter name="to_approve" string="Waiting for Approval" domain="[('state', '=', 'to_approve')]"/>
                <filter name="my_approvals" string="Awaiting My Approval" domain="[('approval_is_mine', '=', True)]"/>
                <filter name="approval_rejected" string="Approval Rejected" domain="[('approval_state', '=', 'rejected')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_picking_to_approve" model="ir.actions.act_window">
        <field name="name">Transfers to Approve</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'to_approve')]</field>
        <field name="context">{'search_default_my_approvals': 1, 'create': False}</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for your approval</p>
            <p>Transfers submitted for approval appear here as soon as one of your tiers is pending.</p>
        </field>
    </record>
</odoo>
