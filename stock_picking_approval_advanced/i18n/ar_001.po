"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\" dir=\"rtl\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        مرحبًا،<br/><br/>\n"
"        التحويل <strong t-out=\"object.name or ''\">WH/OUT/00042</strong>\n"
