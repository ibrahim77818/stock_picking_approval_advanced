"        Hello,<br><br>\n"
"        The transfer <strong t-out=\"object.name or ''\">WH/OUT/00042</strong>\n"
"        (<t t-out=\"object.picking_type_id.display_name or ''\">Delivery Orders</t>)\n"
"        is waiting for your approval at tier\n"
"        <strong t-out=\"object.approval_current_line_id.name or ''\">Warehouse Manager</strong>.\n"
"        <br><br>\n"
"        Requested by: <t t-out=\"object.approval_requested_by_id.name or ''\">Marc Demo</t><br>\n"
"        Source location: <t t-out=\"object.location_id.display_name or ''\">WH/Stock</t><br>\n"
"        Destination location: <t t-out=\"object.location_dest_id.display_name or ''\">Customers</t><br>\n"
"        <t t-if=\"object.partner_id\">Contact: <t t-out=\"object.partner_id.display_name or ''\">Azure Interior</t><br></t>\n"
"        <t t-if=\"object.origin\">Source document: <t t-out=\"object.origin or ''\">S00012</t><br></t>\n"
"        Approval progress: <t t-out=\"object.approval_progress or ''\">0 / 2</t>\n"
"        <br><br>\n"
"        <a t-att-href=\"object.approval_record_url\" style=\"background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;\">\n"
"            Review the transfer\n"
