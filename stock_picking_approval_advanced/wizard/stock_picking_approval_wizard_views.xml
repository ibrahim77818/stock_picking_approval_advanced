<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_approval_wizard_view_form" model="ir.ui.view">
        <field name="name">stock.picking.approval.wizard.form</field>
        <field name="model">stock.picking.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Approval Decision">
                <field name="action" invisible="1"/>
                <field name="require_signature" invisible="1"/>
                <div class="alert alert-danger" role="alert" invisible="action != 'reject'">
                    Rejecting returns the transfer to its requester. A reason is mandatory and will be
                    recorded in the approval history.
                </div>
                <group>
                    <field name="picking_id"/>
                    <field name="tier_name"/>
                </group>
                <group invisible="action != 'approve'">
                    <field name="comment" placeholder="Optional sign-off comment..."/>
                    <field name="signature" widget="signature" required="action == 'approve' and require_signature"
                           options="{'full_name': 'tier_name'}"/>
                </group>
                <group invisible="action != 'reject'">
                    <field name="rejection_reason" required="action == 'reject'"
                           placeholder="Explain why this transfer is rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Approve" class="btn-primary"
                            invisible="action != 'approve'" data-hotkey="q"/>
                    <button name="action_confirm" type="object" string="Reject" class="btn-danger"
                            invisible="action != 'reject'" data-hotkey="q"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
