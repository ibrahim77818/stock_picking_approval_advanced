<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_picking_approval" model="ir.module.category">
        <field name="name">Transfer Approvals</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_picking_approval_user" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_picking_approval"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Can be designated as approver of transfer approval tiers.</field>
    </record>

    <record id="group_picking_approval_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_picking_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_picking_approval_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configures approval rules and can sign off any tier (override).</field>
    </record>

    <record id="rule_picking_approval_rule_company" model="ir.rule">
        <field name="name">Transfer Approval Rule: multi-company</field>
        <field name="model_id" ref="model_stock_picking_approval_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_picking_approval_tier_company" model="ir.rule">
        <field name="name">Transfer Approval Tier: multi-company</field>
        <field name="model_id" ref="model_stock_picking_approval_tier"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_picking_approval_line_company" model="ir.rule">
        <field name="name">Transfer Approval Sign-off: multi-company</field>
        <field name="model_id" ref="model_stock_picking_approval_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
